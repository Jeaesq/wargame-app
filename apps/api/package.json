{
  "name": "@wargame/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build -w @wargame/shared && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "npm run build -w @wargame/shared && tsc --noEmit"
  },
  "dependencies": {
    "@wargame/shared": "0.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.4"
  }
}
